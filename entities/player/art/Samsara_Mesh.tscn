uniform float mix_strength : hint_range(0.0, 2.0, 0.01) = 1.0; 
uniform sampler2D color_lookup : source_color, hint_default_white;
// Added for Residue control
uniform float residue_strength : hint_range(0.0, 2.0, 0.1) = 0.5;
group_uniforms;

varying float LIFETIME;
varying float INDEX;

vec2 polar_coordinates(vec2 uv, vec2 center, float zoomm, float repeat) {
	vec2 dir = uv - center;
	float radius = length(dir) * 2.0;
	float angle = atan(dir.y, dir.x) * 1.0/(3.1416 * 2.0);
	return mod(vec2(radius * zoomm, angle * repeat), 1.0);
}

vec2 rotate(vec2 uv, vec2 pivot, float angle) {
	mat2 rotation = mat2(vec2(sin(angle), -cos(angle)),
						vec2(cos(angle), sin(angle)));
	uv -= pivot;
	uv = uv * rotation;
	uv += pivot;
	return uv;
}

float easeOutExpo(float x) {
	return 1.0 - pow(2.0, -10.0 * x);
}

float easeInExpo(float x) {
	return pow(2.0, 10.0 * x - 10.0);
}

float easeInOut(float x) {
	float result;
	if (x < 0.5) {result = (1.0 - sqrt(1.0 - pow(2.0 * x, 2.0))) / 2.0;}
	else {result =(sqrt(1.0 - pow(-2.0 * x + 2.0, 2.0)) + 1.0) / 2.0;}
	return result;
}

void vertex() {
	LIFETIME = INSTANCE_CUSTOM.y;
	INDEX = float(INSTANCE_ID);
}

float get_progress() {
	float p;
	float final;
	if (derive_progress > 0.0) { p = pow(LIFETIME, fast_start_intensity); }
	else if (derive_progress < 0.0) { p = mod(TIME * time_scale, 1.0); }
	else { p = progress; }
	
	if (ease_progress > 0.0) { final = easeOutExpo(p); }
	else if (ease_progress < 0.0) { final = easeInExpo(p); }
	else { final = p; }
	return final;
}

void fragment() {
	float p = get_progress();
	// We use the raw LIFETIME (or progress) for the residue so it doesn't \"snap\" as hard
	float raw_p = (derive_progress > 0.0) ? LIFETIME : progress;
	
	vec2 aUV = polar_coordinates(rotate(UV, vec2(0.5), radians(rotate_all)), vec2(0.5), zoom, 1.0);
	
	// MAIN SLASH
	vec4 b = texture(base_noise, aUV - vec2(0.0, p));
	vec4 wm = texture(width_gradient_mask, aUV);
	vec4 lm = texture(length_gradient_mask, rotate(aUV - vec2(0.0, easeInOut(p * anim_rot_amt)), vec2(0.5), radians(180.0)));
	
	// RESIDUE LOGIC
	// The residue uses the same noise but stays \"behind\" (no p offset or very little)
	vec4 residue_noise = texture(base_noise, aUV - vec2(0.0, raw_p * 0.1));
	float residue_mask = (1.0 - raw_p); // Fades as the particle ages
	vec4 residue_final = clamp((residue_noise - wm) * residue_mask * residue_strength, 0.0, 1.0);
	
	// COMBINE
	vec4 prefinal = (b - wm) - lm;
	
	// Inject residue into the prefinal look
	vec3 albe = vec3(1.0) * (texture(color_lookup, vec2(clamp(prefinal.r * UV.x, 0.0, 1.0), 0.0)).rgb * mix_strength);
	vec4 high = clamp(texture(highlight, aUV) - (lm), 0.0, 1.0);
	
	// Final colors with residue added to albedo and emission
	vec3 combined_color = clamp(albe + high.rgb + (residue_final.rgb * albe), 0.0, 1.0);
	
	ALBEDO = combined_color;
	EMISSION = combined_color * (3.0 * emission_strength);
	
	// ALPHA CLIPPING
	float start = abs(cos(p * PI));
	float end = abs(cos(p * PI));
	
	// Mix the residue into the alpha so it stays visible after the main slash passes
	float alpha_main = smoothstep(start, end, prefinal.r);
	float alpha_residue = residue_final.r * 0.5;
	
	ALPHA *= clamp(alpha_main + alpha_residue + smoothstep(clamp(start,0.0,0.2), clamp(end,0.0,0.2), (high.r * 0.2)), 0.0, 1.0) * COLOR.a;
